<?xml version="1.0" encoding="utf-8"?>
<!-- v2.25.0: Liquid Glass Midnight Sapphire window background (static
     gradient + glows, no live blur). Navy sapphire. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1130" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0A1030"
                android:centerColor="#1E3A8A"
                android:endColor="#0B1230"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="#0060A5FA"
                android:gradientRadius="650dp"
                android:startColor="#6E60A5FA"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.90"
                android:endColor="#00818CF8"
                android:gradientRadius="650dp"
                android:startColor="#5A818CF8"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
