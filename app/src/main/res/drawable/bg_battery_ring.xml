<?xml version="1.0" encoding="utf-8"?>
<!-- Circular battery ring for the Dashboard device card: a surface
     track plus a primary arc whose sweep follows the progress level. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadius="29dp" android:thickness="7dp" android:useLevel="false">
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <shape android:shape="ring" android:innerRadius="29dp" android:thickness="7dp" android:useLevel="true">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
</layer-list>
