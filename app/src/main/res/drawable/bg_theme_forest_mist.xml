<?xml version="1.0" encoding="utf-8"?>
<!-- v2.25.0: Liquid Glass Forest Mist window background (static
     gradient + glows, no live blur). Dark green mist. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#071A12" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#071A12"
                android:centerColor="#14532D"
                android:endColor="#0A1F14"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="#006EE7B7"
                android:gradientRadius="650dp"
                android:startColor="#5A6EE7B7"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.90"
                android:endColor="#0034D399"
                android:gradientRadius="650dp"
                android:startColor="#6E34D399"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
