<?xml version="1.0" encoding="utf-8"?>
<!-- v2.18 App Locker: soft rounded tile behind the locked app's
     icon on the lock screen (theme attrs, same trick as bg_pill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
</shape>
