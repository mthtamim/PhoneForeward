<?xml version="1.0" encoding="utf-8"?>
<!-- Permission gauge ring (v2.17.2): same construction as the
     dashboard battery ring, sized for the 104dp gauge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadius="40dp" android:thickness="8dp" android:useLevel="false">
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <shape android:shape="ring" android:innerRadius="40dp" android:thickness="8dp" android:useLevel="true">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
</layer-list>
