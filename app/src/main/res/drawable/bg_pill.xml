<?xml version="1.0" encoding="utf-8"?>
<!-- Pill badge: soft primary-container fill with a primary outline —
     the closest flat approximation of the mockups' glowing pills. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="?attr/colorPrimaryContainer" />
    <stroke android:width="1dp" android:color="?attr/colorPrimary" />
    <padding android:left="10dp" android:top="4dp" android:right="10dp" android:bottom="4dp" />
</shape>
