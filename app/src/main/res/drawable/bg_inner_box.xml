<?xml version="1.0" encoding="utf-8"?>
<!-- Inner box (v2.17.2): the darker inset panel used for IF/THEN
     boxes, editor rows and summary strips — #12181A on the dark
     palette, surfaceContainer in the theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="13dp" />
    <solid android:color="?attr/colorSurfaceContainer" />
    <stroke android:width="1dp" android:color="?attr/colorSurfaceVariant" />
</shape>
