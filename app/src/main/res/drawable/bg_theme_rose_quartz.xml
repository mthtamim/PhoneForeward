<?xml version="1.0" encoding="utf-8"?>
<!-- v2.25.0: Liquid Glass Rose Quartz window background (static
     gradient + glows, no live blur). Dark rose. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2B0A1E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2B0A1E"
                android:centerColor="#9D174D"
                android:endColor="#1F0A1C"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="#00F472B6"
                android:gradientRadius="650dp"
                android:startColor="#6EF472B6"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.90"
                android:endColor="#00FB7185"
                android:gradientRadius="650dp"
                android:startColor="#5AFB7185"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
