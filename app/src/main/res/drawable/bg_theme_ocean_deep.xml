<?xml version="1.0" encoding="utf-8"?>
<!-- v2.25.0: Liquid Glass Ocean Deep window background (static
     gradient + glows, no live blur). Deep blue-teal. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#04222F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#032330"
                android:centerColor="#0E7490"
                android:endColor="#082F3E"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="#0038BDF8"
                android:gradientRadius="650dp"
                android:startColor="#5A38BDF8"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.90"
                android:endColor="#002DD4BF"
                android:gradientRadius="650dp"
                android:startColor="#6E2DD4BF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
