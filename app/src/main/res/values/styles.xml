<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Modern design system (v2.5) ===== -->

    <!-- White rounded card, soft border, no heavy shadow -->
    <style name="PL.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorSurfaceVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="PL.BtnFilled" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="PL.BtnOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="PL.BtnTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/md_btnFill</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="PL.BtnText" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Big menu row (Settings categories, Home menu): white card-like row -->
    <style name="PL.MenuBtn" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/md_surface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card section heading inside a page -->
    <style name="PL.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Small explanatory text -->
    <style name="PL.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- A switch row: label fills, switch sits at the end -->
    <style name="PL.SwitchRow" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Permission / status row label -->
    <style name="PL.StatusLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Permission / status row value (colour set from code: green or red) -->
    <style name="PL.StatusValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Soft filled text field (modern rounded look) -->
    <style name="PL.Field" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="boxBackgroundColor">@color/md_surfaceContainer</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- ===== v2.17 redesign styles ===== -->

    <!-- Pill status badge (connection, Shizuku, hub status) -->
    <style name="PL.Pill" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Rounded filter chip (Inbox categories, Command Hub categories) -->
    <style name="PL.ChipFilter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
    </style>

    <!-- Bottom-nav active pill indicator -->
    <style name="PL.NavIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">@style/PL.NavIndicatorShape</item>
    </style>
    <style name="PL.NavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Dashboard / hub tile title -->
    <style name="PL.TileTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Plain rounded search box (Command Hub) -->
    <style name="PL.SearchBox" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
