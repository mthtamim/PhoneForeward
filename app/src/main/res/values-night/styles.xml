        <item name="autoSizeMaxTextSize">13.5sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">7dp</item>
    </style>

    <!-- Tile buttons: the day style fills tiles with md_surface,
         which at night IS the card colour (#171D1F) — the tiles
         vanished into their cards. Raised fill + mint stroke;
         icon tint is NOT set here because tile icons are artwork
         (layouts override with app:iconTint="@null"). -->
    <style name="PL.BtnTile" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">?attr/plTileFill</item>
        <item name="strokeColor">?attr/plBtnStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:minHeight">98dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">13.5sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">40dp</item>
        <item name="iconPadding">5dp</item>
    </style>

    <style name="PL.BtnTileQs" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">?attr/plTileFill</item>
        <item name="strokeColor">?attr/plBtnStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">13sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">40dp</item>
        <item name="iconPadding">4dp</item>
    </style>
</resources>
