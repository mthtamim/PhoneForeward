<?xml version="1.0" encoding="utf-8"?>
<!-- Automation Studio (v2.24.1): NO header row — filled Rules |
     Flows segmented control + ⋮ menu on top, status pill, ONE
     full-width status card (health / rest / sync rows), then the
     rule cards (built by AutomationActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- v2.24.1: no header row — back arrow, "অটোমেশন
             স্টুডিও" title and header Add Rule button removed per
             Tamim's red marks. The filled Rules | Flows segmented
             control + ⋮ menu IS the top row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabRules"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_fill"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/flow_tab_rules"
                    android:textColor="@color/tab_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFlows"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_fill"
                    android:backgroundTint="@color/btn_fill_night"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/flow_tab_flows"
                    android:textColor="@color/tab_text_light"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAutoMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_back_chip"
                android:contentDescription="@string/auto_menu"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>


        <!-- v2.20.1: compact header — one status line (counts + health +
             rest + sync mark); tap expands the full 3-row detail.
             The quick-tool chips and the Study Guard card moved to
             the ⋮ menu so the rules list gets the screen. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
            <LinearLayout
                android:id="@+id/statusLineRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSyncMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="⇄"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvStatusChev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="⌄"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PL.BodySmall"
                        android:layout_width="wrap_content"
                        android:text="@string/auto_health_title" />

                    <TextView
                        android:id="@+id/tvHealthTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/healthRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/auto_rest_label"
                        android:textSize="13.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestTime"
                        style="@style/PL.BtnChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10s"
                        app:icon="@drawable/ic_clock" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/auto_rules_sync"
                        android:textSize="13.5sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swRulesSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- v2.20: FocusLock connection card. It sits at
                     the top of the SCROLL content, not in the fixed
                     header: v2.17.4 deliberately compacted that
                     header to one card, and this card is contextual
                     to the rules below it. One-time token save +
                     install/token status + open-FocusLock. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/flCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fl_card_title"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFlStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            style="@style/PL.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/fl_card_sub" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFlToken"
                                style="@style/PL.BtnChip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/fl_btn_token_set" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFlOpen"
                                style="@style/PL.BtnChip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/fl_btn_open" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/autoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

            <!-- v2.24.0: new-flow FAB, Flows tab only. -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddFlow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="@string/flow_tab_flows"
                android:src="@drawable/ic_plus"
                android:visibility="gone"
                app:backgroundTint="?attr/colorPrimary" />

            <!-- v2.24.1: Add Rule FAB, Rules tab only — same style
                 and position as the Flows FAB; opens the rule
                 editor, the exact action the removed header
                 "+ নিয়ম যোগ করো" button performed. -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddRule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="@string/auto_add"
                android:src="@drawable/ic_plus"
                app:backgroundTint="?attr/colorPrimary" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/autoBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:itemActiveIndicatorStyle="@style/PL.NavIndicator"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
