<?xml version="1.0" encoding="utf-8"?>
<!-- Command Hub page (v2.17): the old Remote sub-screen promoted to a
     bottom-nav tab. Every command button below keeps its original id
     and handler; the search box and category chips only filter which
     tiles are visible (android:tag="hub:sys|cam|sec"). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hub_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHubShizuku"
                style="@style/PL.Pill" />
        </LinearLayout>

        <EditText
            android:id="@+id/etHubSearch"
            style="@style/PL.SearchBox"
            android:layout_marginTop="12dp"
            android:hint="@string/hub_search_hint"
            android:inputType="text"
            android:maxLines="1" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgHubCats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHubAll"
                style="@style/PL.ChipFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/hub_cat_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHubSystem"
                style="@style/PL.ChipFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_cat_system" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHubDisplay"
                style="@style/PL.ChipFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_cat_display" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHubSecurity"
                style="@style/PL.ChipFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_cat_security" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/hub_quick"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnCmdLock"
                        android:tag="hub:sec"
                                            style="@style/PL.BtnTonal"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="4dp"
                                            android:layout_weight="1"
                                            android:text="@string/cmd_lock" />
                    <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCmdNote"
                        android:tag="hub:sec"
                    style="@style/PL.BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                        android:layout_weight="1"
                    android:text="@string/cmd_note" />

        </LinearLayout>

<TextView
                    android:id="@+id/tvSenderSeen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sender_never_seen"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/tvHubPeerState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorPrimary" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/rg_find"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <LinearLayout
