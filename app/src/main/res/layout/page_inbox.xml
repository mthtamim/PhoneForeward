<?xml version="1.0" encoding="utf-8"?>
<!-- Inbox (v2.17.2, approved preview): big title with a live-count
     pill, search first, then the category chips and the list. The
     bKash hero treatment lives in item_inbox / InboxAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PL.H1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/sec_inbox"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvInboxPill"
            style="@style/PL.Pill" />
    </LinearLayout>

    <!-- v2.17.3: preview-style boxed search (filled rounded box +
         leading search icon) — no more underlined Material field.
         Same id, same text watcher in MainActivity. -->
    <EditText
        android:id="@+id/etSearch"
        style="@style/PL.SearchBox"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_search"
        android:hint="@string/hint_search"
        android:inputType="text"
        android:maxLines="1" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgCats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/cat_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSms"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_sms" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCalls"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_calls" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipNotif"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_notif" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBattery"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_battery" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOther"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_other" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStar"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_star" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipArchived"
            style="@style/PL.ChipFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_archived" />
    </com.google.android.material.chip.ChipGroup>

    <ListView
        android:id="@+id/lvInbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshInbox"
            style="@style/PL.BtnChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/btn_refresh"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportInbox"
            style="@style/PL.BtnChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/btn_export_inbox"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearInbox"
            style="@style/PL.BtnChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/btn_clear_inbox"
            app:icon="@drawable/ic_trash" />
    </LinearLayout>
</LinearLayout>
