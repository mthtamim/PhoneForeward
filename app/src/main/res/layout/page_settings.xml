<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== Permissions card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_permissions" />

                <TextView
                    android:id="@+id/tvPermSummary"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenPerms"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_open_perms" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Sender features card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_sender_features" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSms"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_sms" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNotif"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_notif" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCalls"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_calls" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swBattery"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_battery" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swApps"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_apps" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSystem"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_system" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNetwork"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_network" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSecurity"
                    style="@style/PL.SwitchRow"
                    android:text="@string/fwd_security" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLocCmd"
                    style="@style/PL.SwitchRow"
                    android:text="@string/allow_loc_cmd" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRingCmd"
                    style="@style/PL.SwitchRow"
                    android:text="@string/allow_ring_cmd" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFlashCmd"
                    style="@style/PL.SwitchRow"
                    android:text="@string/allow_flash_cmd" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Filters card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_filters" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_excluded">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExcluded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_blocked">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBlocked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveFilters"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_save_filters" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_test" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Smart control card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_smart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_apps" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="6dp"
                    android:text="@string/apps_hint_short" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swQuiet"
                    style="@style/PL.SwitchRow"
                    android:text="@string/quiet_label" />

                <TextView
                    android:id="@+id/tvQuietInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuietTimes"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_quiet_times" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/digest_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvDigestInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDigest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_digest" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_priority">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPriority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="2"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSmart"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_save" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:layout_marginTop="8dp"
                    android:text="@string/priority_hint" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSmsTrigger"
                    style="@style/PL.SwitchRow"
                    android:text="@string/sms_trigger_label" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/sms_trigger_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Security card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_security" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swEncryption"
                    style="@style/PL.SwitchRow"
                    android:text="@string/enc_label" />

                <TextView
                    style="@style/PL.BodySmall"
                    android:text="@string/enc_hint" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAppLock"
                    style="@style/PL.SwitchRow"
                    android:text="@string/lock_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_change_pin" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== More features card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_more" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swTts"
                    style="@style/PL.SwitchRow"
                    android:text="@string/tts_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSmsReply"
                    style="@style/PL.SwitchRow"
                    android:text="@string/sms_reply_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSnap"
                    style="@style/PL.SwitchRow"
                    android:text="@string/snap_label" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGeo"
                    style="@style/PL.SwitchRow"
                    android:text="@string/geo_label" />

                <TextView
                    android:id="@+id/tvGeoInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetGeo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_set_geo" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDailySummary"
                    style="@style/PL.SwitchRow"
                    android:text="@string/daily_summary_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsageAccess"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_usage_access" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Appearance card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_appearance" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_language"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangBn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lang_bn" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLangEn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lang_en" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_theme"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeSystem"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_system" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_dark" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Relay server card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_server" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_server">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PL.Field"
                    android:hint="@string/hint_backup_server">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBackupServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveServer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_save_server" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Offline queue card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_queue" />

                <TextView
                    android:id="@+id/tvQueueInfo"
                    style="@style/PL.BodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewQueue"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_view_queue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlushQueue"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_flush_queue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearQueue"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_queue" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Data & statistics card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PL.CardTitle"
                    android:text="@string/sec_data" />

                <TextView
                    android:id="@+id/tvStats"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetStats"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_reset_stats" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/tvRetentionInfo"
                    style="@style/PL.BodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetention"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_retention" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackupInbox"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_backup_inbox" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestoreInbox"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_restore_inbox" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/PL.BodySmall"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/footer_about" />
    </LinearLayout>
</ScrollView>
