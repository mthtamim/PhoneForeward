<?xml version="1.0" encoding="utf-8"?>
<!-- v2.18 App Locker picker: EVERY installed package is listed
     (user apps by default, system apps behind the toggle), plus a
     manual add-by-package-name field. Hard safety exclusions are
     filtered out of the results in code and refused on manual add. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnPickerBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_back_chip"
            android:contentDescription="@string/btn_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            style="@style/PL.H1"
            android:layout_width="0dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/alk_picker_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etPickerSearch"
            style="@style/PL.SearchBox"
            android:hint="@string/picker_search_hint"
            android:inputType="text"
            app:drawableStartCompat="@drawable/ic_search" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swShowSystem"
            style="@style/PL.SwitchRow"
            android:text="@string/alk_show_system" />

        <TextView
            style="@style/PL.BodySmall"
            android:layout_marginTop="6dp"
            android:text="@string/alk_manual_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etManualPkg"
                style="@style/PL.FieldPlain"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/alk_manual_hint"
                android:inputType="textNoSuggestions"
                android:padding="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualAdd"
                style="@style/PL.BtnChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/alk_btn_add" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/lvPickerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />
</LinearLayout>
