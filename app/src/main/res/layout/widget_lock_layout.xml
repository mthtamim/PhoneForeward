<?xml version="1.0" encoding="utf-8"?>
<!-- v2.18: shared tile for the two screen-lock widgets (a11y / admin).
     Dark v2.17 tile (#101415) + the mint lock glyph; the sub-label is
     set per widget from its provider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wLockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_lock_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/wLockIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/widget_lock_title"
        android:src="@drawable/ic_lock" />

    <TextView
        android:id="@+id/wLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wLockSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#9ADFC3"
        android:textSize="10sp" />
</LinearLayout>
