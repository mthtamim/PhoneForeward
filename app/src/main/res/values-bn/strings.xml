    <string name="footer_about">PhoneLink v1.1 — ডিফল্ট রিলে ntfy.sh (ফ্রি, অ্যাকাউন্ট লাগে না)। দুটি ফোনে একই কোড + একই সার্ভার থাকলেই চলবে। মেসেজ রিলে দিয়ে যায়, তাই পেয়ার কোড গোপন রাখো।</string>

    <string name="perm_title">Permission</string>
    <string name="perm_intro">PhoneLink ঠিকমতো কাজ করতে এই permission গুলো লাগে। যেগুলো দেওয়া আছে সেগুলো সবুজ দেখাবে। এই স্ক্রিনটা অটোমেটিক শুধু প্রথমবারই আসে।</string>
    <string name="perm_notif_title">নোটিফিকেশন Access</string>
    <string name="perm_notif_desc">সব অ্যাপের নোটিফিকেশন ফরোয়ার্ডের জন্য লাগে (WhatsApp, Messenger, বিকাশ…)। সিস্টেমের তালিকায় PhoneLink চালু করে দাও।</string>
    <string name="btn_open_settings">সেটিংস খোলো</string>
